# ── BookWheel backend environment ──────────────────────────────
# Copy to `.env` (git-ignored) and fill in real values. Never commit secrets.

# Environment: development | production
ENVIRONMENT=development

# PostgreSQL connection (Neon). Use the SQLAlchemy+psycopg driver prefix.
# Dev and prod MUST point at different databases/branches.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require

# JWT signing secret — REQUIRED in production. Generate a strong random value:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
# Access token / cookie lifetime in minutes (default 14 days)
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# CORS — exact origin(s) of the deployed frontend. Comma-separate for multiple
# (e.g. production + Vercel preview). No trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# Auth cookie hardening
#   COOKIE_SECURE=true in production (HTTPS only)
#   COOKIE_SAMESITE=lax when frontend & backend share a site;
#                   none for cross-site (different domains) — then COOKIE_SECURE MUST be true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
